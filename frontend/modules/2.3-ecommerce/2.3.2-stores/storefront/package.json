{
  "name": "@mastererp/storefront-web",
  "private": true,
  "version": "0.2.0",
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform web",
    "build:dev": "node scripts/build-dev.mjs",
    "build:local": "node scripts/build-dev.mjs --local",
    "preview:local": "node scripts/preview-local.mjs",
    "dev": "expo start --web",
    "lint": "expo lint",
    "test": "node --test src/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
